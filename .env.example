# --- Sanad Academy backend env ---
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Postgres connection string. Works with any standard Postgres server:
# your hosting provider's own PostgreSQL (usually host="localhost", no sslmode
# needed), or an external provider like Neon (use the "pooled" connection
# string, and keep ?sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of this deployment (no trailing slash). Used to build the
# password-reset link sent by email — deliberately NOT taken from the
# request's Host header, to avoid host-header injection in reset links.
APP_URL="https://your-domain.com"

# Resend (https://resend.com) — used to send password-reset emails.
# RESEND_FROM_EMAIL must be an address on a domain verified in your Resend account.
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="Sanad Academy <no-reply@your-domain.com>"

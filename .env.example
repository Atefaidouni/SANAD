# --- MAFAZ Academy backend env ---
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres connection string (from https://console.neon.tech → your project → Connect).
# Use the "pooled" connection string. Must include ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

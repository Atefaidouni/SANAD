# Next.js declares sharp as its own optional dependency (used only by its
# built-in image optimizer, which this app disables via images.unoptimized
# in next.config.mjs). Skipping optional deps keeps sharp's native binary —
# built for whatever OS/arch runs `npm install` — out of the deploy bundle
# entirely, so it can never be a platform mismatch on the production host.
omit=optional
